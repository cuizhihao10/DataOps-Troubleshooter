# API 与确定性运行预算。使用 Docker 前先把本文件复制成 .env；生成的 .env 绝不能提交，
# 因为它会包含只存在于本机的凭据。所有键都带 DATAOPS_ 前缀，由 pydantic-settings 统一校验。
DATAOPS_ENVIRONMENT=development
DATAOPS_LOG_LEVEL=INFO
DATAOPS_HOST=0.0.0.0
DATAOPS_PORT=8000
DATAOPS_API_PORT=18000
# 步数预算严格大于 Golden 集里最长的必需工具集（跨组件案例最多 6 个必需工具），给真实模型留出
# 一到两步试探余量；零余量等于把"必然拿不到满覆盖"写进配置。
DATAOPS_MAX_REACT_STEPS=8
# 并行度与步数预算是两个独立旋钮：同一轮最多提交这么多个互不依赖的只读 Action，但一批 N 个 Action
# 仍然消耗 N 个步数。因此调大它只压缩 P95 等待时间，不会让 Planner 获得更多取证机会。
DATAOPS_MAX_PARALLEL_TOOL_ACTIONS=3
# 这是覆盖 Planner 决策、LangGraph 调度和 MCP 调用的总墙钟预算，与单个工具超时相互独立；
# 它的作用是防止一串"每步都合法"的调用把整个 run 无限拖住。实测 Planner 单次 8–15s，因此 8 步
# 预算配 150s；配得太紧会让"时间不够"伪装成"步数用完"，两种终止原因的处置方式完全不同。
DATAOPS_REACT_TOTAL_TIMEOUT_SECONDS=150
DATAOPS_MAX_GRAPH_HOPS=2
DATAOPS_MAX_AUDIT_REVISIONS=1
DATAOPS_TOOL_TIMEOUT_SECONDS=5
DATAOPS_TOOL_RETRY_COUNT=1
# 资源 API 的鉴权与限流（api-auth:v1）。默认关闭鉴权，让 `docker compose up` 之后就能直接演示，
# 因此 Compose 只把 API 端口绑定到 127.0.0.1。要保护 /api/v1 与 /metrics，必须同时把模式切成
# bearer 并设置至少 32 个可见 ASCII 字符的令牌；只设其中一个会拒绝启动——"配了令牌但模式是
# disabled"会让部署者误以为接口已受保护。令牌行请保持注释而不是留空：空串会被解析成"已配置的
# 空令牌"。限流在两种模式下都生效，配额按来源 IP 计数。
DATAOPS_API_AUTH_MODE=disabled
DATAOPS_API_RATE_LIMIT_REQUESTS=120
DATAOPS_API_RATE_LIMIT_WINDOW_SECONDS=60
# DATAOPS_API_AUTH_TOKEN=在此填入本机专用的至少32位随机令牌
# SSE 推流（run-stream:v1）只是 run 状态与公开事件的另一种读法：run 仍由 Worker 执行，断流不会改变
# 任何结论，前端随时可以退回轮询。轮询间隔决定事件出现在浏览器上的延迟下限，心跳周期让反向代理
# 相信空闲连接仍然活着，最长存活时间保证被遗忘的标签页不会永久占用连接。三者必须依次递增，且
# 最长存活时间要大于 ReAct 总超时，否则一个只是跑满预算的正常 run 会在结束前被推流截断。
# 注意浏览器 EventSource 无法设置请求头：鉴权切到 bearer 后推流一定被拒，此时前端只能走轮询。
DATAOPS_RUN_STREAM_POLL_SECONDS=0.5
DATAOPS_RUN_STREAM_KEEPALIVE_SECONDS=15
DATAOPS_RUN_STREAM_MAX_SECONDS=300
# Planner/Auditor 的模型访问默认关闭，因此测试与 Docker 演示不需要任何付费 API。启用时把
# provider 改成 openai-compatible，并在 .env（不是本文件）里写入端点、模型名和只存本机的 API key；
# 两个 Agent 共用同一个端点配置，但各自持有独立 Prompt、Schema 和一次修复预算。
DATAOPS_CHAT_PROVIDER=disabled
DATAOPS_CHAT_MODEL=gpt-5.6
DATAOPS_CHAT_BASE_URL=https://api.openai.com/v1
DATAOPS_CHAT_TIMEOUT_SECONDS=30
# Auditor 超时单列：它要读完整草稿并逐条核对引用，实测耗时是 Planner 的两到三倍。共用 30s 会让
# 审计频繁超时，而超时按"审计不可用"直接降级，等于把审计路径整条关掉。
DATAOPS_AUDITOR_TIMEOUT_SECONDS=90
DATAOPS_PLANNER_SCHEMA_REPAIR_COUNT=1
DATAOPS_AUDITOR_SCHEMA_REPAIR_COUNT=1
# DATAOPS_CHAT_API_KEY=在此填入只存本机的密钥
# 离线确定性 Provider 让测试和作品集演示在没有凭据时也能跑通。替换 Provider 要走统一接口，
# 不要把 PostgreSQL 查询耦合到某个模型 SDK；算法变化必须换一个带版本的 provider ID，
# 这样新旧向量空间永远不会混算。
DATAOPS_EMBEDDING_PROVIDER=deterministic-hash:v1
DATAOPS_EMBEDDING_DIMENSIONS=128
# 切换到真实多语言模型的方式是把 provider 设为 bge-m3:v1，同时把维度设为 1024 并在 .env 里配置
# 只存本机的密钥。启动审计会拒绝"缺密钥"或"维度不匹配"的组合，因此半配置的部署不可能一边继续
# 返回 feature hashing 向量、一边宣称自己在做语义检索。
DATAOPS_EMBEDDING_MODEL=BAAI/bge-m3
DATAOPS_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
DATAOPS_EMBEDDING_TIMEOUT_SECONDS=30
DATAOPS_EMBEDDING_BATCH_SIZE=32
# DATAOPS_EMBEDDING_API_KEY=在此填入只存本机的密钥
# 第二阶段是 cross-encoder，对有界候选集重新打分。它默认关闭，因为每次检索都要多一次付费调用；
# 关闭时结果里的 reranker_model 为空，所以任何报告都不可能把一阶段排序说成精排结果。
# multiplier 决定一阶段为二阶段多取多少候选，blend weight 是唯一把重排分混入 final_score 的系数。
DATAOPS_RERANK_PROVIDER=disabled
DATAOPS_RERANK_MODEL=BAAI/bge-reranker-v2-m3
DATAOPS_RERANK_BASE_URL=https://api.siliconflow.cn/v1
DATAOPS_RERANK_TIMEOUT_SECONDS=20
DATAOPS_RERANK_CANDIDATE_MULTIPLIER=3
DATAOPS_RERANK_BLEND_WEIGHT=0.4
# DATAOPS_RERANK_API_KEY=在此填入只存本机的密钥
# 混合评分的五个权重分别对应语义、词面、图路径、来源可信度和案例时效性，必须精确等于 1.0。
DATAOPS_RETRIEVAL_SEMANTIC_WEIGHT=0.45
DATAOPS_RETRIEVAL_LEXICAL_WEIGHT=0.10
DATAOPS_RETRIEVAL_PATH_WEIGHT=0.25
DATAOPS_RETRIEVAL_RELIABILITY_WEIGHT=0.10
DATAOPS_RETRIEVAL_FRESHNESS_WEIGHT=0.10
# Evidence Bundle 预算按选中的节点/路径/文档切片 JSON 的精确 UTF-8 字节数计算。节点、路径和文档
# 三个上限相互独立：这样大量短记录无法绕过上下文控制，少数长 Runbook 切片也不会把图路径全部挤掉。
DATAOPS_RETRIEVAL_CONTEXT_MAX_BYTES=6000
DATAOPS_RETRIEVAL_CONTEXT_MAX_NODES=8
DATAOPS_RETRIEVAL_CONTEXT_MAX_PATHS=4
DATAOPS_RETRIEVAL_CONTEXT_MAX_DOCUMENTS=3
DATAOPS_DIAGNOSIS_RETRIEVAL_SEED_LIMIT=5
# 文档 RAG 是第二条知识通道：检索和引用单位是切片而不是整篇文档。它的三个权重必须精确等于 1.0，
# 并且刻意不含 path/freshness——对静态切片来说这两个因子没有诚实含义。authority 直接取文档人工
# 声明的 reliability，因此调高它等于显式宣布"越权威的文档越优先"，这是产品判断而非实现细节。
DATAOPS_DOCUMENT_SEMANTIC_WEIGHT=0.60
DATAOPS_DOCUMENT_LEXICAL_WEIGHT=0.25
DATAOPS_DOCUMENT_AUTHORITY_WEIGHT=0.15
DATAOPS_DOCUMENT_RETRIEVAL_CHUNK_LIMIT=4
# 长期案例记忆在用户显式决策前一直是 pending。先比对精确的组件/根因签名，再做 pgvector 余弦相似度。
# confirmed 案例复用已存向量作为 GraphRAG 案例节点；另有一个更低且可独立观察的阈值，用来连接
# "相似但不该合并"的案例。
DATAOPS_MEMORY_DEDUP_SIMILARITY_THRESHOLD=0.92
DATAOPS_CASE_GRAPH_SIMILARITY_THRESHOLD=0.75
DATAOPS_MEMORY_SEARCH_LIMIT=5
DATAOPS_MEMORY_QUERY_MAX_CHARS=4000
DATAOPS_FIXTURE_DIRECTORY=data/fixtures/scenarios
DATAOPS_GOLDEN_CASE_FILE=data/fixtures/golden_cases.json
# 图种子、文档语料与本机 PostgreSQL 配置。DATAOPS_DB_AUTH 是只存本机的凭据占位符，由 Docker
# Compose 做变量插值，API 不会记录它。文档 manifest 及其 Markdown 文件与图种子在同一个事务里
# 加载并提交，因此部署不可能出现"图已就绪、文档语料缺失"的中间状态。
DATAOPS_KNOWLEDGE_SEED_FILE=data/knowledge/cross_chain_graph.json
DATAOPS_DOCUMENT_MANIFEST_FILE=data/knowledge/documents/manifest.json
DATAOPS_DB_AUTH=在此填入本机专用的数据库口令
DATAOPS_DB_PORT=15432
